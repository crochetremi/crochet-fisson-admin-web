###
# Création des Unités Organisationnelles (OU)
###

dn: ou=users,dc=iutnc-crochet-fisson,dc=local
objectClass: organizationalUnit
ou: users

dn: ou=groups,dc=iutnc-crochet-fisson,dc=local
objectClass: organizationalUnit
ou: groups


###
# Création d'un utilisateur de test pour Nextcloud
###

dn: uid=jdoe,ou=users,dc=iutnc-crochet-fisson,dc=local
objectClass: inetOrgPerson
uid: jdoe
sn: Doe
givenName: John
cn: John Doe
displayName: John Doe
# Le mot de passe ici est "password" (généré avec slappasswd)
userPassword: {SSHA}y7+1k7r0O6h5g8b2Z/0Tz+O1z8h8a4b